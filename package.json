{
  "name": "reservoir",
  "private": true,
  "type": "module",
  "description": "tsncd, the renderer of the neural circuit diagrams, pinned to one commit, with the tools its bundle and its dev server need at the versions tsncd's own lock holds",
  "scripts": {
    "tsncd:build": "webpack --mode production",
    "tsncd:relay": "tsx node_modules/tsncd/src/run_server.ts",
    "tsncd:page": "webpack serve --mode development --no-open --host 127.0.0.1"
  },
  "devDependencies": {
    "css-loader": "7.1.3",
    "html-webpack-plugin": "5.6.6",
    "style-loader": "4.0.0",
    "ts-loader": "9.5.4",
    "tsncd": "git+https://github.com/starbaser/tsncd.git#b8649a6492c15244cf2b0be49e0acf2e2abb32d7",
    "tsx": "^4.21.0",
    "typescript": "5.9.3",
    "webpack": "5.104.1",
    "webpack-cli": "6.0.1",
    "webpack-dev-server": "5.2.3"
  }
}
